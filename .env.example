# OpsMemory AI Configuration

# Server Ports
PORT=3001
FRONTEND_PORT=5173

# Hindsight Configuration
# Point to local Hindsight container or Cloud instance
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opsmemory-production

# AI / LLM Configuration (Optional: fallback engine runs automatically if empty)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Environment
NODE_ENV=development
